DB_HOST=localhost
DB_PORT=5432
DB_NAME=notification_dev
DB_USER=postgres
DB_PASS=postgres

APP_PORT=3000

CORS_ORIGINS=http://localhost:3000

# Public origin of this API, used for absolute logo URLs in emails.
# Defaults to http://localhost:$APP_PORT
# PUBLIC_URL=https://notify.example.com

# Encrypts provider credentials (API keys, SMTP passwords) at rest.
# Generate with: openssl rand -base64 32
# Changing it makes previously saved credentials unreadable.
PROVIDER_SECRET_KEY=
