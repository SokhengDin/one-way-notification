DB_HOST=localhost
DB_PORT=5432
DB_NAME=notification_dev
DB_USER=postgres
DB_PASS=postgres
# Connection pool shared by API requests and the delivery worker
# DB_POOL_MAX=20

APP_PORT=3000

CORS_ORIGINS=http://localhost:3000

# Public origin of this API, used for absolute logo URLs in emails.
# Defaults to http://localhost:$APP_PORT
# PUBLIC_URL=https://notify.example.com

# Encrypts provider credentials (API keys, SMTP passwords) at rest.
# Generate with: openssl rand -base64 32
# Changing it makes previously saved credentials unreadable.
PROVIDER_SECRET_KEY=

# ---------- delivery worker ----------
# Runs inside the API process. Safe to run in several replicas at once.
# DELIVERY_WORKER_ENABLED=true
# DELIVERY_POLL_INTERVAL_MS=1000
# DELIVERY_BATCH_SIZE=20
# Deliveries sent at the same time within a batch. Raise for throughput,
# lower if a provider rate-limits you. `bun run bench` measures it.
# DELIVERY_CONCURRENCY=10
# Attempts per delivery before it is marked failed (backoff 30s, 1m, 2m, 4m…)
# DELIVERY_MAX_ATTEMPTS=5
# Per provider call
# DELIVERY_SEND_TIMEOUT_MS=15000
# How long a claimed delivery is reserved for one worker
# DELIVERY_LEASE_SECONDS=120

# ---------- dashboard sign-in ----------
# On first start with no administrator, one is created from these. Safe to
# leave set: nothing happens once an admin exists. Or: bun run admin:create -- you@example.com
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=at-least-12-characters
# ADMIN_NAME=Your Name

# file storage for brand assets (file-vault); uploads answer 503 until set.
# Local dev without file-vault: `bun run file-vault:fake` serves an in-memory
# one on :3301 with the key fv_fake_local_key.
FILE_VAULT_URL=http://localhost:3301
FILE_VAULT_API_KEY=fv_fake_local_key
# FILE_VAULT_SPACE_ID=
# FILE_VAULT_SPACE_NAME=one-way-notification
