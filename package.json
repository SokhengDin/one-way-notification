{
  "name": "one-way-notification",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "bun run --filter server dev",
    "dev:web": "bun run --filter web dev",
    "migrate": "bun --cwd=apps/server run db/migrate.ts"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
