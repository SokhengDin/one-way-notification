{
  "name": "one-way-notification",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "bun --cwd=apps/server run dev",
    "dev:web": "bun --cwd=apps/web run dev",
    "migrate": "bun --cwd=apps/server run db/migrate.ts",
    "test": "bun --cwd=apps/server run test",
    "typecheck": "bun --cwd=apps/server run typecheck",
    "seed:demo": "bun --cwd=apps/server run db/seed-demo.ts",
    "admin:create": "bun --cwd=apps/server run db/create-admin.ts"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
