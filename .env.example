# docker compose settings. Copy to .env and fill in the required values.
#   cp .env.example .env

# ---------- required ----------
DB_PASS=
# Encrypts provider credentials at rest. openssl rand -base64 32
# Changing it makes previously saved credentials unreadable.
PROVIDER_SECRET_KEY=
# Seals the dashboard session cookie, >= 32 chars. openssl rand -base64 48
SESSION_SECRET=

# ---------- database ----------
# Default reaches a Postgres on the Docker host. Use `postgres` with the
# optional compose service, or any hostname for a managed database.
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=notification_db
DB_USER=postgres
# DB_POOL_MAX=20

# ---------- first administrator ----------
# Created on first start when no admin exists; ignored afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# ---------- ports on the host ----------
API_PORT=3000
DASHBOARD_PORT=3001

# ---------- public URLs ----------
# Public origin of the API, used for absolute logo URLs in emails
PUBLIC_URL=http://localhost:3000
# Public origin of the dashboard (metadata, baked in at build time)
# NEXT_PUBLIC_SITE_URL=https://notify-admin.example.com
# Set to false ONLY when the dashboard is served over plain HTTP, e.g.
# http://<server-ip>:3001. Leave true behind HTTPS (and on http://localhost).
COOKIE_SECURE=true
# SECURITY_CONTACT=mailto:security@example.com

# ---------- file storage (file-vault) ----------
# Brand assets (logos, icons, email headers) are stored in file-vault
# (SokhengDin/one-way-file-service). Without these two, the API still runs
# but asset uploads answer 503.
# Create the key in the file-vault dashboard with scopes
#   files:read files:write files:delete  (+ spaces:manage unless FILE_VAULT_SPACE_ID is set)
# FILE_VAULT_URL is reached from inside the backend container, either
#   https://files.example.com         file-vault's public URL (its gateway routes /v1/*), or
#   http://file-vault-backend:8080    when both stacks share a Docker network
#                                     (uncomment `networks` in docker-compose.yml)
FILE_VAULT_URL=
FILE_VAULT_API_KEY=
# Use an existing space; otherwise the space named below is found or created.
# FILE_VAULT_SPACE_ID=
# FILE_VAULT_SPACE_NAME=one-way-notification
# FILE_VAULT_TIMEOUT_MS=10000

# ---------- delivery worker ----------
DELIVERY_WORKER_ENABLED=true
DELIVERY_CONCURRENCY=10
DELIVERY_BATCH_SIZE=20
