# docker compose settings. Copy to .env and fill in the required values.
#   cp .env.example .env

# ---------- required ----------
DB_PASS=
# Encrypts provider credentials at rest. openssl rand -base64 32
# Changing it makes previously saved credentials unreadable.
PROVIDER_SECRET_KEY=
# Seals the dashboard session cookie, >= 32 chars. openssl rand -base64 48
SESSION_SECRET=

# ---------- database ----------
# Default reaches a Postgres on the Docker host. Use `postgres` with the
# optional compose service, or any hostname for a managed database.
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=notification_db
DB_USER=postgres
# DB_POOL_MAX=20

# ---------- first administrator ----------
# Created on first start when no admin exists; ignored afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# ---------- ports on the host ----------
API_PORT=3000
DASHBOARD_PORT=3001

# ---------- public URLs ----------
# Public origin of the API, used for absolute logo URLs in emails
PUBLIC_URL=http://localhost:3000
# Public origin of the dashboard (metadata, baked in at build time)
# NEXT_PUBLIC_SITE_URL=https://notify-admin.example.com
# Set to false ONLY when the dashboard is served over plain HTTP, e.g.
# http://<server-ip>:3001. Leave true behind HTTPS (and on http://localhost).
COOKIE_SECURE=true
# SECURITY_CONTACT=mailto:security@example.com

# ---------- delivery worker ----------
DELIVERY_WORKER_ENABLED=true
DELIVERY_CONCURRENCY=10
DELIVERY_BATCH_SIZE=20
